<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated from whatever Jekyll builds — no plugin, nothing to maintain. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.html_pages -%}
{%- unless p.noindex or p.url contains "404" %}
  <url><loc>{{ p.url | replace: "index.html", "" | absolute_url }}</loc></url>
{%- endunless -%}
{%- endfor -%}
{%- for f in site.static_files -%}
{%- if f.extname == ".html" and f.path != "/404.html" %}
  <url><loc>{{ f.path | replace: "index.html", "" | absolute_url }}</loc></url>
{%- endif -%}
{%- endfor %}
</urlset>
